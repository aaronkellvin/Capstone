SECRET_KEY=change-me-in-production
# development | production
BLOOM_ENV=development
# Show login pilot-account shortcuts (auto-on in local demo when SECRET_KEY is the built-in fallback)
BLOOM_SHOW_PILOTS=
# Allow demo user seeding when BLOOM_ENV=production (default off)
BLOOM_SEED_DEMO=0
# 1 enables Flask debug reloader (default on in development, off in production)
FLASK_DEBUG=
SESSION_COOKIE_SECURE=
PORT=5001
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
